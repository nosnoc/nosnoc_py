<?xml version="1.0"?>
<robot name="two_link_robot">

    <!-- Here we only define colors like reusable variables -->
    <material name="green">
        <color rgba=".3 .6 .4 1"/>
    </material>
    <material name="red">
        <color rgba=".9 .1 0 1"/>
    </material>
    <material name="blue">
        <color rgba="0.1 0.3 0.5 1"/>
    </material>
    <!-- ============================================================ -->
    <!-- BASE LINK                                                    -->
    <!-- ============================================================ -->

    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.15 0.15 0.15"/>
            </geometry>
            <material name="green"/>
        </visual>
    </link>

    <!-- ============================================================ -->
    <!-- JOINT 1                                                      -->
    <!-- Connects base_link to link1                                  -->
    <!-- ============================================================ -->

    <joint name="joint1" type="revolute">
        <parent link="base_link"/>
        <child link="link1"/>
        <!-- joint located at origin of base -->
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <!-- rotation around Z -->
        <axis xyz="0 0 1"/>
        <limit
            lower="-3.14159"
            upper="3.14159"
            effort="20"
            velocity="5"/>
    </joint>

    <!-- ============================================================ -->
    <!-- LINK 1                                                       -->
    <!-- Length = 1 m                                                 -->
    <!-- Mass   = 1 kg                                                -->
    <!-- ============================================================ -->

    <link name="link1">
        <!-- What the link looks like -->
        <visual>
            <!--
                The box itself is centered around its origin.
                We want the link to extend from x = 0 to x = 1,
                so we place its visual center at x = 0.5.
            -->
            <origin xyz="0.5 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="1.0 0.08 0.08"/>
            </geometry>
            <material name="red"/>
        </visual>

        <!-- Collision geometry -->
        <collision>
            <origin xyz="0.5 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="1.0 0.08 0.08"/>
            </geometry>
        </collision>

        <!-- Physical properties used for dynamics -->
        <inertial>
            <!-- Center of mass -->
            <origin xyz="0.5 0 0" rpy="0 0 0"/>
            <mass value="1.0"/>
            <inertia
                ixx="0.0010667"
                ixy="0.0"
                ixz="0.0"
                iyy="0.0838667"
                iyz="0.0"
                izz="0.0838667"/>
        </inertial>
    </link>

    <!-- ============================================================ -->
    <!-- JOINT 2                                                      -->
    <!-- Located at end of link1                                      -->
    <!-- ============================================================ -->

    <joint name="joint2" type="revolute">
        <parent link="link1"/>
        <child link="link2"/>
        <!-- link1 is 1 meter long -->
        <origin xyz="1.0 0 0" rpy="0 0 0"/>
        <!-- again rotation around Z -->
        <axis xyz="0 0 1"/>
        <limit
            lower="-3.14159"
            upper="3.14159"
            effort="20"
            velocity="5"/>
    </joint>

    <!-- ============================================================ -->
    <!-- LINK 2                                                       -->
    <!-- Length = 1 m                                                 -->
    <!-- Mass   = 1 kg                                                -->
    <!-- ============================================================ -->

    <link name="link2">
        <visual>
            <origin xyz="0.5 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="1.0 0.08 0.08"/>
            </geometry>
            <material name="blue"/>
        </visual>

        <collision>
            <origin xyz="0.5 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="1.0 0.08 0.08"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0.5 0 0" rpy="0 0 0"/>
            <mass value="1.0"/>
            <inertia
                ixx="0.0010667"
                ixy="0.0"
                ixz="0.0"
                iyy="0.0838667"
                iyz="0.0"
                izz="0.0838667"/>
        </inertial>
    </link>
</robot>